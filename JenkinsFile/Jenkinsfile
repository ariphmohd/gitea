pipeline {
    agent any

    parameters {
        string(name: 'AWS_REGION', defaultValue: 'ap-south-1', description: 'AWS region where ECR exists')
        string(name: 'ECR_REPO',   defaultValue: 'gitea',      description: 'ECR repository name')
    }

    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Set Image Tag') {
            steps {
                script {
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}"
                    echo "IMAGE_TAG = ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                withCredentials([
                    string(credentialsId: 'ecr-registry', variable: 'ECR_REGISTRY')
                ]) {
                    sh '''
                        set -e

                        IMAGE_NAME="${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"

                        echo "Building image: ${ECR_REPO}:${IMAGE_TAG}"

                        docker build -t "${IMAGE_NAME}" .
                    '''
                }
            }
        }

        stage('Trivy Security Scan') {
            steps {
                withCredentials([
                    string(credentialsId: 'ecr-registry', variable: 'ECR_REGISTRY')
                ]) {
                    sh '''
                        set -e

                        IMAGE_NAME="${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"

                        echo "=== Trivy scanning: ${ECR_REPO}:${IMAGE_TAG} ==="

                        # ensure host cache dir exists (persists the vuln DB)
                        mkdir -p "${HOME}/.cache/trivy"

                        docker run --rm \
                          -v /var/run/docker.sock:/var/run/docker.sock \
                          -v "${HOME}/.cache/trivy:/root/.cache/" \
                          aquasec/trivy:latest image \
                            --severity HIGH,CRITICAL \
                            --no-progress \
                            --scanners vuln \
                            --exit-code 0 \
                            --timeout 10m \
                            "${IMAGE_NAME}"

                        echo "=== Trivy scan completed (report-only) ==="
                    '''
                }
            }
        }

        stage('Login to AWS ECR') {
            steps {
                withCredentials([
                    string(credentialsId: 'ecr-registry', variable: 'ECR_REGISTRY')
                ]) {
                    sh '''
                        set +x
                        set -e

                        echo "Logging in to AWS ECR..."

                        aws ecr get-login-password --region "${AWS_REGION}" | \
                        docker login --username AWS --password-stdin "${ECR_REGISTRY}"

                        echo "ECR login successful."
                    '''
                }
            }
        }

        stage('Push Docker Image to ECR') {
            steps {
                withCredentials([
                    string(credentialsId: 'ecr-registry', variable: 'ECR_REGISTRY')
                ]) {
                    sh '''
                        set -e

                        IMAGE_NAME="${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"

                        echo "Pushing image: ${ECR_REPO}:${IMAGE_TAG}"

                        docker push "${IMAGE_NAME}"

                        echo "Push completed successfully."
                    '''
                }
            }
        }

    }
}
# Tested