pipeline {
    agent any

    parameters {
        string(name: 'AWS_REGION', defaultValue: 'ap-south-1', description: 'AWS region where ECR exists')
        string(name: 'ECR_REPO',   defaultValue: 'gitea',      description: 'ECR repository name')
    }

    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Set Image Tag') {
            steps {
                script {
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}"
                    echo "IMAGE_TAG = ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                withCredentials([
                    string(credentialsId: 'ecr-registry', variable: 'ECR_REGISTRY')
                ]) {
                    sh '''
                        set -e

                        IMAGE_NAME="${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"

                        echo "Building image: ${ECR_REPO}:${IMAGE_TAG}"

                        docker build -t "${IMAGE_NAME}" .
                    '''
                }
            }
        }

        stage('Login to AWS ECR') {
            steps {
                withCredentials([
                    string(credentialsId: 'ecr-registry', variable: 'ECR_REGISTRY')
                ]) {
                    sh '''
                        set +x
                        set -e

                        echo "Logging in to AWS ECR..."

                        aws ecr get-login-password --region "${AWS_REGION}" | \
                        docker login --username AWS --password-stdin "${ECR_REGISTRY}"

                        echo "ECR login successful."
                    '''
                }
            }
        }

        stage('Push Docker Image to ECR') {
            steps {
                withCredentials([
                    string(credentialsId: 'ecr-registry', variable: 'ECR_REGISTRY')
                ]) {
                    sh '''
                        set -e

                        IMAGE_NAME="${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"

                        echo "Pushing image: ${ECR_REPO}:${IMAGE_TAG}"

                        docker push "${IMAGE_NAME}"

                        echo "Push completed successfully."
                    '''
                }
            }
        }

        stage('Update Manifest Repo') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-manifest-creds',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        # 1. Clone the manifest repo fresh (shallow = fast)
                        rm -rf manifest-repo
                        git clone --depth 1 \
                          https://${GIT_USER}:${GIT_TOKEN}@github.com/ariphmohd/gitea-k8s-manifests.git \
                          manifest-repo

                        cd manifest-repo

                        # 2. Update the image tag in the deployment file
                        #    Replaces whatever tag is there with the new BUILD_NUMBER
                        sed -i "s#\\(126830716304.dkr.ecr.ap-south-1.amazonaws.com/gitea:\\).*#\\1${BUILD_NUMBER}#" \
                          gitea/05-gitea-deployment.yaml

                        # 3. Show what changed (for the build log)
                        echo "New image line:"
                        grep "gitea:" gitea/05-gitea-deployment.yaml

                        # 4. Set commit identity
                        git config user.email "jenkins@ci.local"
                        git config user.name  "Jenkins CI"

                        # 5. Commit only if something actually changed
                        if git diff --quiet; then
                          echo "No image change, skipping commit."
                        else
                          git add gitea/05-gitea-deployment.yaml
                          git commit -m "ci: update gitea image to ${BUILD_NUMBER}"
                          git push origin main
                          echo "Manifest updated to gitea:${BUILD_NUMBER}"
                        fi
                    '''
                }
            }
        }

    }
}
